# Netlify / Cloudflare Pages: long-lived caching for product media (URLs are versioned with ?v=<hash>)
/assets/products/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/products/*.mp4
  Cache-Control: public, max-age=31536000, immutable
/assets/products/manifest.json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000
/sw.js
  Cache-Control: no-cache
